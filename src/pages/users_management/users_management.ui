<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="adw" version="1.0"/>

  <template class="UsersManagementPage" parent="GtkBox">
    <property name="orientation">vertical</property>
    <property name="margin-top">16</property>
    <property name="margin-bottom">16</property>
    <property name="hexpand">True</property>
    <property name="vexpand">True</property>

    <child>
      <object class="GtkGrid">
        <property name="hexpand">True</property>
        <property name="vexpand">True</property>
        <property name="halign">fill</property>
        <property name="valign">fill</property>

        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="spacing">16</property>
            <property name="hexpand">True</property>
            <property name="halign">fill</property>
            <property name="valign">center</property>

            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="spacing">16</property>
                <property name="hexpand">True</property>

                <child>
                  <object class="AdwClamp" id="users_content_clamp">
                    <property name="maximum-size">630</property>
                    <property name="tightening-threshold">630</property>
                    <property name="hexpand">True</property>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="hexpand">True</property>
                        <property name="halign">fill</property>
                        <property name="spacing">16</property>
                        <child>
                          <object class="GtkBox" id="users_card">
                            <property name="orientation">vertical</property>
                            <property name="hexpand">True</property>
                            <property name="halign">fill</property>
                            <property name="overflow">hidden</property>
                            <style>
                              <class name="card"/>
                            </style>
                            <child>
                              <object class="GtkPicture" id="users_image">
                                <property name="hexpand">True</property>
                                <property name="can-shrink">True</property>
                                <property name="halign">fill</property>
                                <property name="valign">center</property>
                                <property name="content-fit">contain</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">16</property>
                            <property name="hexpand">True</property>
                            <property name="valign">center</property>
                            <property name="margin-top">16</property>
                            <property name="margin-bottom">16</property>
                            <child>
                              <object class="GtkLabel" id="users_heading">
                                <property name="wrap">True</property>
                                <property name="halign">fill</property>
                                <property name="justify">left</property>
                                <property name="xalign">0</property>
                                <property name="label" translatable="yes">Compartilha seu computador com outras pessoas?</property>
                                <style>
                                  <class name="heading"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="users_description">
                                <property name="wrap">True</property>
                                <property name="max-width-chars">60</property>
                                <property name="halign">fill</property>
                                <property name="justify">left</property>
                                <property name="xalign">0</property>
                                <property name="label" translatable="yes">Configure uma conta de usuário separada para cada usuário para proteger a privacidade individual de cada usuário que compartilha o mesmo computador</property>
                                <style>
                                  <class name="body"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton" id="configure_users_button">
                                <property name="label" translatable="yes">Configurar Usuários</property>
                                <property name="halign">fill</property>
                                <style>
                                  <class name="suggested-action"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>

              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>